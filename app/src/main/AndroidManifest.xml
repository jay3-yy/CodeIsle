<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".OpenIsleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Openisle"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <activity
            android:name=".presentation.features.common.ImageViewerActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.features.search.SearchActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.features.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.features.profile.UserProfileActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.features.common.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.features.feed.MainActivity"
            android:exported="false"
            android:hardwareAccelerated="false" />

        <activity
            android:name=".presentation.features.postdetail.PostDetailActivity"
            android:exported="false" />

    </application>

</manifest>